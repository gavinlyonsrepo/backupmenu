}

# FUNCTION HEADER
# NAME : pathTarFunc
# DESCRIPTION : Function to create a tarball of a user selected directory
pathTarFunc()
{
	local Path2Var=""
	Path2Var="$1"
	local tarNameVar=""
	tarNameVar="$2"
	bmtPrintFunc norm "Source directory:  \"$Path2Var\""
	bmtPrintFunc norm "Destination : $(pwd)"
	bmtPrintFunc norm "Do you want to continue? [Y / n]"
	bmtPromptFunc yesno no
	case $? in
		0)
			bmtPrintFunc norm " No"
		;;
		2)	
			if [ ! -d "$Path2Var" ]; then
				exitHandlerFunc misc_dir_path
			fi  
			tar -pzcvf "$tarNameVar" "$Path2Var"
		;;
		50)
			bmtPrintFunc norm "Bad user option"
			;;
	esac
	bmtPrintFunc b_green "Done!"
}