# FUNCTION HEADER
# NAME : SystemBackFunc
# DESCRIPTION: Displays destination directory picker menu to user
function SystemDestFunc
{
	clear
	#get user input for backup
	local optionsBUArr=("$BM_DEST_PATH_1" "$BM_DEST_PATH_2" "$BM_DEST_PATH_3" \
	"$BM_DEST_PATH_4" "$BM_DEST_PATH_5" "$BM_DEST_PATH_6" "Custom" "Exit")
	local choiceBUVar=""
	bmtPrintFunc b_cyan "Pick Destination directory for backup"
	select  choiceBUVar in "${optionsBUArr[@]}"
	#check that paths exist and change path to DEST path
	do
	case "$choiceBUVar" in
	
	"${optionsBUArr[0]}")
		if [ ! -d "$BM_DEST_PATH_1" ]; then
				exitHandlerFunc "destination_path_1"
		fi  
		cd "$BM_DEST_PATH_1" || exitHandlerFunc "destination_path_1"
		;;				
	"${optionsBUArr[1]}") 
		if [ ! -d "$BM_DEST_PATH_2" ]; then
				exitHandlerFunc "destination_path_2"
		fi  
		cd "$BM_DEST_PATH_2" || exitHandlerFunc "destination_path_2"
		;;	
	"${optionsBUArr[2]}") 
		if [ !  -d "$BM_DEST_PATH_3" ]; then
				exitHandlerFunc "destination_path_3"
		fi  
		cd "$BM_DEST_PATH_3" || exitHandlerFunc "destination_path_3"
		;;
	"${optionsBUArr[3]}") 
		if [ !  -d "$BM_DEST_PATH_4" ]; then
				exitHandlerFunc "destination_path_4"
		fi  
		cd "$BM_DEST_PATH_4" || exitHandlerFunc "destination_path_4"
		;;
	"${optionsBUArr[4]}") 
		if [ !  -d "$BM_DEST_PATH_5" ]; then
				exitHandlerFunc "destination_path_5"
		fi  
		cd "$BM_DEST_PATH_5" || exitHandlerFunc "destination_path_5"
		;;
	"${optionsBUArr[5]}") 
		if [ !  -d "$BM_DEST_PATH_6" ]; then
				exitHandlerFunc "destination_path_6"
		fi  
		cd "$BM_DEST_PATH_6" || exitHandlerFunc "destination_path_6"
		;;
	"${optionsBUArr[6]}") 
		customPathFunc 		 #custom path read in 
		;;

	*) return ;;
	esac
	break
	done
	makeDirFunc "-BACKUP" 
	SystemTypeFunc
}

#FUNCTION HEADER
# NAME: SystemTypeFunc 
# DESCRIPTION: Displays the menu which offers backup options to use
# called from  SystemDestFunc
function  SystemTypeFunc
{
	local choiceBu2Var=""
	local optionsBu2Arr=("Make copy of MBR or GPT with dd " "Copy of etc dir" \
"Copy of home dir" "Copy of package lists" "Make tarball of all System" \
"Options 1-5 combined" "Custom Tarball" "Documents Tarball" "Pictures Tarball" "Videos Tarball" "Music Tarball" \
"Exit")
	bmtPrintFunc b_cyan "Pick a Backup option:-"
	select  choiceBu2Var in "${optionsBu2Arr[@]}"
	do
	case  "$choiceBu2Var" in
	"${optionsBu2Arr[0]}"|"${optionsBu2Arr[5]}") #MBR
		mbrFunc
	;;&
	"${optionsBu2Arr[1]}"|"${optionsBu2Arr[5]}") # etc
		bmtPrintFunc b_green "Make a copy of etc dir"
		sudo cp -a -v -u /etc .
		bmtPrintFunc b_green "Done!"
	;;&
	"${optionsBu2Arr[2]}"|"${optionsBu2Arr[5]}") # home
		bmtPrintFunc b_green "Make a copy of home dir"
		sudo cp -a -v -u /home .
		bmtPrintFunc b_green "Done!"
		sync
	;;&
	"${optionsBu2Arr[3]}"|"${optionsBu2Arr[5]}") # packages list
		mkdir -p "PKGLISTFILES" || exitHandlerFunc misc_dir_path
		cd "PKGLISTFILES" || exitHandlerFunc misc_dir_path
		pkglistFunc 
		cd ..
	;;&
	"${optionsBu2Arr[4]}"|"${optionsBu2Arr[5]}") # system tar
		bmtPrintFunc b_green "Make tarball of all except tmp dev proc sys run"
		sudo tar --one-file-system --exclude=/tmp/* --exclude=/dev/* --exclude=/proc/* --exclude=/sys/* --exclude=/run/* -pzcvf RootFS_backup.tar.gz /
		bmtPrintFunc b_green "Done!"
		sync 
	;;
	"${optionsBu2Arr[6]}") # custom tar
		customTarFunc
	;;
	"${optionsBu2Arr[7]}") # Documents tar
		pathTarFunc "$HOME/Documents" "Documents_backup.tar.gz"
	;;
	"${optionsBu2Arr[8]}") # Pictures tar
		pathTarFunc "$HOME/Pictures" "Pictures_backup.tar.gz"
	;;
	"${optionsBu2Arr[9]}") # Videos tar
		pathTarFunc "$HOME/Videos" "Videos_backup.tar.gz"
	;;
	"${optionsBu2Arr[10]}") # Music tar
		pathTarFunc "$HOME/Music" "Music_backup.tar.gz"
	;;
	*) return
	;;
	esac
	break
	done
}

#FUNCTION HEADER
# NAME :  pkglistFunc
# DESCRIPTION: Creates a copy of packages list see below.
function pkglistFunc
{
	bmtPrintFunc b_green "Making a copy of package lists."
	local DistroChoice=""
	local choiceVar=""
	
	bmtLinuxFunc distrocheck
	case $? in
		4)
			bmtPrintFunc  norm "Debian based Distro detected"
			DistroChoice=2
		;;
		5)
			bmtPrintFunc norm "Arch Based Distro detected"
			DistroChoice=3
		;;
		*)
			bmtPrintFunc b_yellow "Unsupported Distro type detected"
			bmtPrintFunc norm "Press D for Debian pased , A for Arch based, Q to quit"
			while true; do
				read -r choiceVar
				case $choiceVar in
					[Dd]*) 
						DistroChoice=2
						break
					;;
					[Aa]*) 
						DistroChoice=3
						break
					;;
					[Qq]*) return ;;
					*) bmtPrintFunc b_yellow "Please answer: (a/A for Arch) OR (d/D for deb) OR (q/Q to quit)!" ;;
				esac
			done
		;;
	esac
	
	local pid=""
	# call spinner function put run in background and save PID
	echo " "
	spinFunc &
	pid=$!
	case "$DistroChoice"  in
		2)
			dpkg --list | grep ^i > all_PKG
			apt-mark showmanual > Exp_PKG
			deborphan > noinstall_PKG 
			apt-cache stats > stats_PKG
			aptitude search '~N' > Recent_add_PKG
			deborphan -anp1 > non-Dep_PKG
			apt-mark showauto > auto_Dep_PKG
			apt-cache policy > Info_Source_PKG
			cat /etc/apt/sources.list.d/*.list | grep -v "^#" > non_standard_PKG
			aptitude search "~i" --display-format "%p %I" --sort installsize > install_size_PKG
			grep installed /var/log/dpkg.log > Install_date_1_PKG
			grep " install " /var/log/dpkg.log > Install_date_2_PKG
		;;
		3)
			pkglistFuncArch
		;;
		esac
	
	# Stop spin function with PID
	kill $pid
	echo " "
}

# FUNCTION HEADER
# NAME :   pkglistFuncArch
# DESCRIPTION : Creates a copy of packages list. For Arch based distros.
function pkglistFuncArch
{
	bmtPrintFunc norm "1: All .pacnew and .pacsave files : pacNewSaveFiles.txt" #1
	find / -path /run/media -prune -o -path /mnt -prune -o -regextype posix-extended -regex ".+\.pac(new|save)" \
	 -fprint pacNewSaveFiles.txt -exec echo -n "." \; 2> /dev/null 
	bmtPrintFunc norm " "
	
	bmtPrintFunc norm "2: All installed packages: pkgQ.txt" #2
	pacman -Q  > pkgQ.txt
	
	bmtPrintFunc norm "3: All native packages: pkgQn.txt"  #3
	pacman -Qn > pkgQn.txt
	
	bmtPrintFunc norm "4: All explicitly installed packages: pkgQe.txt"  #4
	pacman -Qe  > pkgQe.txt
	
	bmtPrintFunc norm "5: All explicitly installed native packages that are" #5
	bmtPrintFunc norm "not direct or optional dependencies: pkgQent.txt"
	pacman -Qent > pkgQent.txt
	
	bmtPrintFunc norm "6: All foreign installed packages: pkgQm.txt" #6
	pacman -Qm > pkgQm.txt
	
	bmtPrintFunc norm "7: All foreign explicitly installed packages: pkgQme.txt" #7
	pacman -Qme > pkgQme.txt
	
	bmtPrintFunc norm "8: All orphan packages not required as dependencies: pkgOpn.txt"
	pacman -Qtdq > pkgOpn.txt #8
	
	bmtPrintFunc norm "9: All modified by user system backup files : pkgSysBck.txt"
	pacman -Qii | awk '/^MODIFIED/ {print $2}' > pkgSysBck.txt  #9
	
	bmtPrintFunc norm "10: All packages installed as dependencies : pkgQd.txt"
	pacman -Qd > pkgQd.txt #10
	
	bmtPrintFunc norm "11: All explicitly installed native packages "
	bmtPrintFunc norm "quiet output for system restore : pkgQqne.txt"
	pacman -Qqne > pkgQqne.txt #11
	
	bmtPrintFunc norm "12: All packages that are optional dependencies "
	bmtPrintFunc norm "and not installed explicitly :pkgOptdep.txt"
	comm -13 <(pacman -Qdtq | sort) <(pacman -Qdttq | sort) > pkgOptdep.txt #12

	#expac
	bmtPrintFunc norm "13: All explicitly installed packages not in the meta package "
	bmtPrintFunc norm "base nor package group xorg with size and description: pkgNonBase.txt"
	mapfile -t _pkgList < <(comm -23 <(pacman -Qqen | sort) <({ pacman -Qqg xorg; expac -l '\n' '%E' base; } \
	| sort -u))
	expac -H M "%011m\t%-20n\t%10d" "${_pkgList[@]}" | sort -n > pkgNonBase.txt #13
	
	bmtPrintFunc norm "14: All explicitly installed packages that are not direct or optional dependencies" 
	bmtPrintFunc norm "not in the meta package base nor package group xorg with size and description: pkgexpNonBase.txt"
	mapfile -t _pkgList < <(comm -23 <(pacman -Qqent | sort) <({ pacman -Qqg xorg; expac -l '\n' '%E' base; } \
	| sort -u))
	expac -H M "%011m\t%-20n\t%10d" "${_pkgList[@]}" | sort -n > pkgexpNonBase.txt #14 #14
	
	bmtPrintFunc norm "15: All installed packages sorted by size: pkgSize.txt"
	expac -H M '%m\t%n' | sort -hr > pkgSize.txt #15
	
	bmtPrintFunc norm "16: All installed packages sorted by install/update date: pkgDate.txt"
	expac --timefmt='%Y-%m-%d %T' '%l\t%n' | sort -hr > pkgDate.txt #16
	
	bmtPrintFunc norm "17: All installed groups: pkgGroups.txt"
	expac -g '%G' | sort -u > pkgGroups.txt #17
	
	#paclist
	bmtPrintFunc norm "Packages by repositories:-"
	bmtPrintFunc norm "18: Core: $(paclist core > pkgCore.txt ) : pkgCore.txt" #18
	bmtPrintFunc norm "19: Extra: $(paclist extra > pkgExtra.txt ) : pkgExtra.txt" #19
	bmtPrintFunc norm "21: Multilib: $(paclist multilib > pkgMulib.txt ): pkgMulib.txt" #21
	bmtPrintFunc norm "22: All installed packages sorted by very first install date: pkginstall.txt" #22
	local pacQArr 
	mapfile -t pacQArr < <(pacman -Qq | sort)
	# get length of an array
	tLen="${#pacQArr[@]}"
	for (( i=0; i<"${tLen}"; i++ ));
	do
		if [ $(( i % 100 )) -eq 0 ] 
		then
			echo -n  "."
		fi
		echo "${pacQArr[i]}" >> pkginstall.txt
		sed -n "/ installed ${pacQArr[i]} /{s/].*/]/p;q}" /var/log/pacman.log  >> pkginstall.txt
	done
	echo " "
	bmtPrintFunc norm "23: All development/unstable packages(cvs svn git hg bzr darcs) : pkgdevel.txt" #23
	pacman -Qq | awk '/^.+(-cvs|-svn|-git|-hg|-bzr|-darcs)$/' >> pkgdevel.txt
	
	if checkPacFunc flatpak #24
	then
		bmtPrintFunc norm "24: All flatpak packages installed: pkgFlatpak.txt"
		flatpak list > pkgFlatpak.txt
	else
		bmtPrintFunc norm "Skipping list number 24 as flatpak not installed"
	fi
	
	if checkPacFunc auracle #25
	then
		checkNetFunc "aur.archlinux.org"
		bmtPrintFunc norm "25: All foreign packages not in the AUR: pkgFNotAUR.txt" 
		for p in $(pacman -Qmq); do
			if [ -z "$(auracle info "$p")" ]; then
				echo -n "."
				echo "$p" >> pkgFNotAUR.txt
			fi
		done
		echo " "
	else
		bmtPrintFunc norm "Skipping list number 25 as auracle not installed"
	fi
	
	bmtPrintFunc norm "26: System packages list information summary : pkginfo.txt"  #26
	{
	echo "See https://github.com/gavinlyonsrepo/cylon/blob/master/documentation/package_lists.md" 
	echo "Line count of package files:"
	wc -l ./*txt | head -n -1 | sort
	} >> pkginfo.txt
}

# FUNCTION HEADER
# NAME: spinFunc
# DESCRIPTION: Creates an animation spinner for long time taking process.
function spinFunc
{
	spinner=( Ooooo oOooo ooOoo oooOo ooooO oooOo ooOoo oOooo);
	while true; do
		for i in "${spinner[@]}"; 
		do 
			# no new line , \r reset line       
			echo -ne "\r$i";
			sleep 0.2;
		done;
	done
}

# FUNCTION HEADER
# NAME: rsyncFunc
# DESCRIPTION: Carries out rsync utility option 
function rsyncFunc
{
	clear
	# check if rsync is installed
	local DistroChoice=""
	bmtLinuxFunc distrocheck
	case $? in
		4) DistroChoice=2 ;; #deb
		5) DistroChoice=1 ;; #arch 
	esac
	if ! bmtLinuxFunc checkpac "rsync" "$DistroChoice"
	then
		bmtPrintFunc red "rsync"
		bmtPrintFunc yellow "rsync may not be installed, check install?."
	else
		bmtPrintFunc b_green "rsync is installed, proceeding with rsync backup option."
	fi
	bmtPrintFunc b_green "rsync backup utility"
	bmtPrintFunc norm "Source & destination are read from config file"
	bmtPrintFunc norm "Source: $BM_RSYNC_SOURCE_PATH"
	bmtPrintFunc norm "Destination: $BM_RSYNC_DEST_PATH"
	bmtPrintFunc norm "Do you want to continue? [Y / n]"
	bmtPromptFunc yesno no
	case $? in
		0)
			bmtPrintFunc norm " You have chosen no."
		;;
		2)
			if [ ! -d "$BM_RSYNC_SOURCE_PATH" ]; then
				bmtPrintFunc red "Source Path"
				exitHandlerFunc "misc_dir_path"
			fi
			if [ ! -d "$BM_RSYNC_DEST_PATH" ]; then
				bmtPrintFunc red "Destination Path"
				exitHandlerFunc "misc_dir_path"
			fi
			sudo rsync -aAXv --delete \
			--exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found"} \
			"$BM_RSYNC_SOURCE_PATH" "$BM_RSYNC_DEST_PATH"
		;;
		50)
			bmtPrintFunc norm "Bad user option"
		;;
	esac
	bmtPrintFunc b_green "Done!"
}

# FUNCTION HEADER
# NAME: mbrFunc
# DESCRIPTION: Makes a copy of MBR or GPT primary partition with dd
# RETURN: 0 if successful, 2 if unsupported drive or partition table detected
mbrFunc()
{
	bmtPrintFunc b_green "Make copy of MBR or GPT with dd"
	#get /dev/sdxy where currenty filesystem is mounted 
	local myddpathVar=""
	local mbrVar=""
	myddpathVar="$(df /boot/ --output=source | tail -1)"
	if [ "$myddpathVar" != "/dev/sda" ]
	then
		bmtPrintFunc norm "$mbrVar"
		bmtPrintFunc yellow "Unsupported drive detected, nothing done "
		return 2
	fi
	#get the partition type 
	mbrVar=$(sudo parted /dev/sda  print | grep -i 'Partition Table' | awk -F": " '{ print $2 }')
	bmtPrintFunc norm "Filesystem is mounted  at : $myddpathVar"
	if [ "$mbrVar" = "gpt" ]
	then
		bmtPrintFunc norm  "GPT partition table detected : $mbrVar"
		sudo dd if="$myddpathVar" of=hda-gpt.bin bs=512 skip=1 count=33
	elif [ "$mbrVar" = "msdos" ]
	then
		bmtPrintFunc norm "Standard MBR partition table detected : $mbrVar"
		sudo dd if="$myddpathVar" of=hda-mbr.bin bs=512 count=1
	else
		bmtPrintFunc norm "$mbrVar"
		bmtPrintFunc yellow "Unsupported partition table detected, nothing done "
	fi
	
	bmtPrintFunc b_green "Done!"
	return 0
}

# FUNCTION HEADER
# NAME : customTarFunc
# DESCRIPTION : Function to create a custom tarball of a user selected directory
customTarFunc()
{
	bmtPrintFunc b_green "custom  Data"
	local Path2Var=""
	Path2Var=$(dialog --title "Custom Source backup" --output-fd 1 --begin 1 1 --cancel-label "Exit" --title  "Select Soucre Directory" --dselect / 10 40) 
	case $? in
		0)
			clear
			bmtPrintFunc b_green "Custom Tarball"
			bmtPrintFunc norm "Custom Source directory:  \"$Path2Var\""
			bmtPrintFunc norm "Destination : $(pwd)"
		;;
		1)
			clear
			bmtPrintFunc norm " "
			bmtPrintFunc yellow "Exit pressed."
			return
		;;
		255)
			clear
			bmtPrintFunc norm " "
			bmtPrintFunc yellow "Esc pressed."
			return
		;;
	esac
	bmtPrintFunc norm "Do you want to continue? [Y / n]"
	bmtPromptFunc yesno no
	case $? in
		0)
			bmtPrintFunc norm " No"
		;;
		2)
			if [ ! -d "$Path2Var" ]; then
				exitHandlerFunc misc_dir_path
			fi  
			tar -pzcvf Custom_backup.tar.gz "$Path2Var"
		;;
		50)
			bmtPrintFunc norm "Bad user option"
		;;
	esac
	bmtPromptFunc anykey "" b_green
}

# FUNCTION HEADER
# NAME : customPathFunc
# DESCRITPION : Function to select a directory via dialog for destination.
customPathFunc()
{
	local Path1Var=""
	Path1Var=$(dialog --title "Custom backup" --output-fd 1 --begin 1 1 --cancel-label "Exit" --title  "Select Destination path" --dselect / 10 40) 
	case $? in
		0)
			clear
			bmtPrintFunc norm " "
			bmtPrintFunc norm "Custom Destination  directory:  \"$Path1Var\" "
		;;
		1)
			clear
			bmtPrintFunc norm " "
			bmtPrintFunc yellow "Exit pressed."
			return
		;;
		255)
			clear
			bmtPrintFunc norm " "
			bmtPrintFunc yellow "Esc pressed."
			return
		;;
	esac
	cd "$Path1Var" || exitHandlerFunc misc_dir_path 
}

# FUNCTION HEADER
# NAME : pathTarFunc
# DESCRIPTION : Function to create a tarball of a user selected directory
pathTarFunc()
{
	local Path2Var=""
	Path2Var="$1"
	local tarNameVar=""
	tarNameVar="$2"
	bmtPrintFunc norm "Source directory:  \"$Path2Var\""
	bmtPrintFunc norm "Destination : $(pwd)"
	bmtPrintFunc norm "Do you want to continue? [Y / n]"
	bmtPromptFunc yesno no
	case $? in
		0)
			bmtPrintFunc norm " No"
		;;
		2)	
			if [ ! -d "$Path2Var" ]; then
				exitHandlerFunc misc_dir_path
			fi  
			tar -pzcvf "$tarNameVar" "$Path2Var"
		;;
		50)
			bmtPrintFunc norm "Bad user option"
			;;
	esac
	bmtPrintFunc b_green "Done!"
}